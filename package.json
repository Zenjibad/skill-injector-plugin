{
  "name": "skill-injector-plugin",
  "version": "1.1.0",
  "description": "Auto-inject user-chosen skills (e.g. caveman, ponytail) into DeepSeek Harness sessions: every prompt or once at session start, with a settings page and a composer indicator. 在 DSH 会话中自动注入所选技能（如 caveman、ponytail）：每轮提示或仅在会话开始时，含设置页与输入区指示。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/helpers.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src",
    "tests",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "skills",
    "skill-injection",
    "caveman",
    "ponytail",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/"
  }
}
